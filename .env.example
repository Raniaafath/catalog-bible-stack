# Environment Variables Template

# Copy this file to .env and update with your values
# cp .env.example .env

# ============================================
# Django Core Settings
# ============================================

# SECURITY WARNING: Generate a strong secret key for production
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=unsafe-dev-key-change-me-in-production

# SECURITY WARNING: Never set DEBUG=1 in production
# 0 = False (production), 1 = True (development only)
DJANGO_DEBUG=1

# Comma-separated list of allowed origins for CSRF protection
# Required in production for security
# Example: https://api.example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ============================================
# Database Configuration (PostgreSQL)
# ============================================

DB_NAME=catalog_bible
DB_USER=catalog_user
DB_PASSWORD=catalog_password_change_me
DB_HOST=db
DB_PORT=5432

# For local development without Docker, use:
# DB_HOST=localhost

# ============================================
# Localization Settings
# ============================================

# Default locale for content fallback
# Options: en-US, de-DE, fr-FR, es-ES, etc.
DEFAULT_LOCALE_CODE=fr

# Title rendering: use only target locale for attribute translations (no fallback).
# When true: de-DE titles use only de-DE translations; missing = raw value.
# When false: fall back to DEFAULT_LOCALE_CODE, which can mix languages.
TITLE_STRICT_LOCALE=true

# ============================================
# External Service Integrations
# ============================================

# OpenAI API (for automated translations)
# Get your API key from: https://platform.openai.com/api-keys
# Leave empty to skip AI translations
OPENAI_API_KEY=

# OpenAI model to use for translations
# Options: gpt-4o-mini, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Google Ads API
# Configure via docker/google-ads.yaml file instead
# See docker/google-ads.yaml.example for setup

# ============================================
# Performance & Server Configuration
# ============================================

# Gunicorn worker processes (recommended: 2-4 x CPU cores)
GUNICORN_WORKERS=3

# Request timeout in seconds
GUNICORN_TIMEOUT=60

# ============================================
# Optional: Caching (Redis)
# ============================================

# Uncomment and configure if using Redis for caching
# REDIS_URL=redis://redis:6379/1

# ============================================
# Optional: Email Configuration
# ============================================

# Uncomment and configure for email sending
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@example.com

# ============================================
# Optional: Monitoring & Logging
# ============================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# ============================================
# Login / Frontend API (troubleshooting)
# ============================================
# If login fails: (1) Ensure Django is running (e.g. port 8000).
# (2) Frontend: with VITE_API_BASE_URL=/api/v1, Vite dev server proxies /api to Django
#     (set VITE_API_PROXY_TARGET=http://127.0.0.1:8000 if Django is elsewhere).
# (3) Create a user: use Sign up on the login page, or:
#     python manage.py createsuperuser
#     Then log in with that email and password.
#
# Production (e.g. https://bib.neomarkgroup.fr):
# - Frontend is built with VITE_API_BASE_URL=/api/v1, so the browser calls same-origin /api/v1/...
# - Your reverse proxy (nginx/caddy) MUST forward /api to the Django backend, e.g.:
#     location /api/ { proxy_pass http://127.0.0.1:8000; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
# - Set DJANGO_CSRF_TRUSTED_ORIGINS=https://bib.neomarkgroup.fr (and any other frontend origins).
# - Restart Django after changing env; no need to rebuild the frontend if only proxy was fixed.

# ============================================
# Development Settings
# ============================================

# Enable Django Debug Toolbar (development only)
# ENABLE_DEBUG_TOOLBAR=1

# Enable SQL query logging (development only)
# ENABLE_SQL_LOGGING=1
